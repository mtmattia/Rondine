<?xml version="1.0" encoding="utf-8"?>
<!-- Solo nella versione libera (F-Droid, GitHub): verifica del numero tra amici (SPEC §14.1).
     Chi verifica fa lo squillo e lo chiude da sé. Niente permessi su SMS e registro chiamate:
     Android li blocca alle app installate fuori dallo store, e lo squillo lo riceve il filtro
     chiamate. Google Play non permette nemmeno questi: lì lo squillo si fa a mano. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
</manifest>
